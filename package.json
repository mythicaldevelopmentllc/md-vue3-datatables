{
  "name": "@mythicaldev/md-vue3-datatables",
  "version": "1.0.4",
  "description": "Set of simple datatable components for Vue 3.",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "style": "dist/main.css",
  "typings": "dist/types/index.d.ts",
  "types": "dist/types/index.d.ts",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:prod": "npm run prebuild && npm run build:css && npm run build:tsc",
    "prebuild": "rimraf ./dist",
    "build:css": "cross-env NODE_ENV=production node_modules/.bin/sass src/scss/index.scss dist/main.css --style compressed",
    "build:tsc": "NODE_ENV=production tsc --project tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mythicaldevelopmentllc/md-vue3-datatables.git"
  },
  "dependencies": {},
  "devDependencies": {
    "cross-env": "^7.0.3",
    "sass-embedded": "^1.83.1",
    "typescript": "~5.6.3",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.0"
  },
  "keywords": [
    "vue3",
    "datatables",
    "vue",
    "components",
    "table",
    "pagination",
    "searchable",
    "filter"
  ],
  "author": "Jeremiah Poisson <jpoisson@mythicaldev.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mythicaldevelopmentllc/md-vue3-datatables/issues"
  },
  "homepage": "https://github.com/mythicaldevelopmentllc/md-vue3-datatables#readme"
}
